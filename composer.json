{
    "name": "enggarasmoro/laravel-error-alert",
    "description": "Low overhead, asynchronous error email alerts for Laravel 6 through 13.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/enggarasmoro/laravel-error-alert",
    "keywords": ["laravel", "error-alert", "email", "queue", "monitoring"],
    "require": {
        "php": ">=7.2.5",
        "illuminate/cache": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/http-kernel": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {"psr-4": {"Enggarasmoro\\LaravelErrorAlert\\": "src/"}},
    "autoload-dev": {"psr-4": {"Enggarasmoro\\LaravelErrorAlert\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Enggarasmoro\\LaravelErrorAlert\\ErrorAlertServiceProvider"], "aliases": {"ErrorAlert": "Enggarasmoro\\LaravelErrorAlert\\Facades\\ErrorAlert"}}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
